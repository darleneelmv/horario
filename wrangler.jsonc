{
  // Configuración para publicar como Cloudflare Worker (Workers & Pages → conectado a GitHub).
  "name": "horario",
  "main": "worker/index.js",
  "compatibility_date": "2025-09-01",
  // Conserva las variables puestas en el panel de Cloudflare (APP_PIN) al publicar desde GitHub.
  "keep_vars": true,
  "assets": { "directory": "./public", "binding": "ASSETS" },
  "kv_namespaces": [
    // AGENDA = el KV "agenda". El id está en Storage & Databases → KV → agenda.
    { "binding": "AGENDA", "id": "120abfb355ad4b0bb17958f20246d1e8" }
  ]
}
